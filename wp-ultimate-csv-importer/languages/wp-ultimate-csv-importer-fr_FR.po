msgid "Loving WP Ultimate CSV Importer? 💙"
msgstr "Vous aimez WP Ultimate CSV Importer ? 💙"

msgid "We’d be so grateful if you could share your experience in a quick review. It only takes a minute, and it really helps us reach more WordPress users like you."
msgstr "Nous serions très reconnaissants si vous pouviez partager votre expérience dans un court avis. Cela ne prend qu'une minute, et cela nous aide vraiment à atteindre plus d'utilisateurs WordPress comme vous."

msgid "⭐ Sure, I’ll Rate It"
msgstr "⭐ Bien sûr, je vais l'évaluer"

msgid "Maybe Later"
msgstr "Peut-être plus tard"

msgid "No, Thanks"
msgstr "Non, merci"

msgid "Maintenance Mode"
msgstr "Mode de maintenance"

msgid "Site is under maintenance mode. Please wait a few minutes!"
msgstr "Le site est en mode de maintenance. Veuillez patienter quelques minutes !"

msgid "Ultimate CSV Importer Free"
msgstr "Ultimate CSV Importer Gratuit"

msgid "Manage Addons"
msgstr "Gérer les extensions"

msgid "Can't insert this %s"
msgstr "Impossible d'insérer ceci %s"

msgid "Can't insert this %1$s. %2$s"
msgstr "Impossible d'insérer ceci %1$s. %2$s"

msgid "Inserted %1$s ID: %2$d, %3$s"
msgstr "Inséré %1$s ID : %2$d, %3$s"

msgid "Updated %1$s ID: %2$d, %3$s"
msgstr "Mis à jour %1$s ID : %2$d, %3$s"

msgid "Skipped. No matching record found."
msgstr "Ignoré. Aucun enregistrement correspondant trouvé."

msgid "<b style='color: red;'>Notice:</b> Cannot create content. Invalid API key provided. Please check your API key."
msgstr "<b style='color: red;'>Avis :</b> Impossible de créer du contenu. Clé API non valide fournie. Veuillez vérifier votre clé API."

msgid "<b style='color: red;'>Notice:</b> Cannot create content. Rate limit reached for requests or you exceeded your current quota."
msgstr "<b style='color: red;'>Avis :</b> Impossible de créer du contenu. Limite de requêtes atteinte ou quota dépassé."

msgid "<b style='color: red;'>Notice:</b> Cannot create content. Please check your inputs."
msgstr "<b style='color: red;'>Avis :</b> Impossible de créer du contenu. Veuillez vérifier vos saisies."

msgid "<b style='color: red;'>Notice:</b> Cannot create content. The server had an error while processing your request."
msgstr "<b style='color: red;'>Avis :</b> Impossible de créer du contenu. Erreur serveur lors du traitement de votre demande."

msgid "<b style='color: red;'>Notice:</b> Cannot create content. The engine is currently overloaded, please try again later."
msgstr "<b style='color: red;'>Avis :</b> Impossible de créer du contenu. Le moteur est surchargé, veuillez réessayer plus tard."

msgid "<b style='color: red;'>Notice:</b> Cannot create short description. Invalid API key provided. Please check your API key."
msgstr "<b style='color: red;'>Avis :</b> Impossible de créer une courte description. Clé API non valide."

msgid "<b style='color: red;'>Notice:</b> Cannot create short description. Rate limit reached for requests or you exceeded your current quota."
msgstr "<b style='color: red;'>Avis :</b> Impossible de créer une courte description. Limite de requêtes atteinte."

msgid "<b style='color: red;'>Notice:</b> Cannot create short description. Please check your inputs."
msgstr "<b style='color: red;'>Avis :</b> Impossible de créer une courte description. Veuillez vérifier vos saisies."

msgid "<b style='color: red;'>Notice:</b> Cannot create short description. The server had an error while processing your request."
msgstr "<b style='color: red;'>Avis :</b> Impossible de créer une courte description. Erreur serveur."

msgid "<b style='color: red;'>Notice:</b> Cannot create short description. The engine is currently overloaded, please try again later."
msgstr "<b style='color: red;'>Avis :</b> Impossible de créer une courte description. Le moteur est surchargé."
